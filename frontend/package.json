{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && serwist build serwist.config.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "analyze": "ANALYZE=true next build --webpack && serwist build serwist.config.mjs",
    "model": "gltf-transform optimize \"${MODEL_SRC:-$HOME/Downloads/KYC-model/KYC_civic.glb}\" public/models/civic.v1.glb --compress meshopt --texture-compress webp --join false --flatten false --instance false --palette false --simplify false"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@serwist/next": "^9.5.13",
    "maath": "^0.10.8",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "serwist": "^9.5.13",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@next/bundle-analyzer": "^16.4.6",
    "@serwist/cli": "^9.5.13",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
